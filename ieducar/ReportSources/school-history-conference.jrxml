<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="school-history-conference" 
              pageWidth="595" pageHeight="842" columnWidth="555" 
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" 
              uuid="conf-history-999717">
	<parameter name="ano" class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
	<parameter name="instituicao" class="java.lang.Integer"><defaultValueExpression><![CDATA[1]]></defaultValueExpression></parameter>
	<parameter name="escola" class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
	<parameter name="matricula" class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
	<parameter name="logo" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
	<parameter name="data_emissao" class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
	<parameter name="source" class="java.lang.String"/>

	<queryString language="json"><![CDATA[main]]></queryString>

	<field name="nm_instituicao" class="java.lang.String"/>
	<field name="nm_escola" class="java.lang.String"/>
	<field name="cod_escola" class="java.lang.Integer"/>
	<field name="nome_aluno" class="java.lang.String"/>
	<field name="cod_aluno" class="java.lang.Integer"/>
	<field name="cod_matricula" class="java.lang.Integer"/>
	<field name="data_nasc" class="java.lang.String"/>
	<field name="sexo" class="java.lang.String"/>
	<field name="nm_curso" class="java.lang.String"/>
	<field name="nm_serie" class="java.lang.String"/>
	<field name="nm_turma" class="java.lang.String"/>
	<field name="nm_pai" class="java.lang.String"/>
	<field name="nm_mae" class="java.lang.String"/>
	<field name="situacao_aluno" class="java.lang.String"/>
	<field name="data_atual" class="java.lang.String"/>
	<field name="data_extenso" class="java.lang.String"/>

	<background>
		<band height="802" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="280" width="555" height="120" forecolor="#E0E0E0" uuid="st-watermark"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" rotation="None">
					<font fontName="DejaVu Sans" size="48" isBold="true"/>
				</textElement>
				<text><![CDATA[EM CONFERÊNCIA]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="380" width="555" height="40" forecolor="#CCCCCC" uuid="st-watermark-sub"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="DejaVu Sans" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[DOCUMENTO INTERNO SEM VALOR OFICIAL]]></text>
			</staticText>
		</band>
	</background>

	<detail>
		<band height="700" splitType="Stretch">
			<subreport>
				<reportElement x="0" y="0" width="555" height="80" uuid="sub-header-conf"/>
				<subreportParameter name="logo"><subreportParameterExpression><![CDATA[$P{logo}]]></subreportParameterExpression></subreportParameter>
				<subreportParameter name="titulo"><subreportParameterExpression><![CDATA["HISTÓRICO ESCOLAR - RASCUNHO / EM CONFERÊNCIA"]]></subreportParameterExpression></subreportParameter>
				<subreportParameter name="cod_instituicao"><subreportParameterExpression><![CDATA[$P{instituicao}]]></subreportParameterExpression></subreportParameter>
				<subreportParameter name="cod_escola"><subreportParameterExpression><![CDATA[$F{cod_escola}]]></subreportParameterExpression></subreportParameter>
				<subreportParameter name="ano"><subreportParameterExpression><![CDATA[$P{ano}]]></subreportParameterExpression></subreportParameter>
				<subreportParameter name="data_emissao"><subreportParameterExpression><![CDATA[$P{data_emissao}]]></subreportParameterExpression></subreportParameter>
				<subreportParameter name="source"><subreportParameterExpression><![CDATA[$P{source}]]></subreportParameterExpression></subreportParameter>
				<subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "header-portrait.jasper"]]></subreportExpression>
			</subreport>

			<rectangle>
				<reportElement x="0" y="85" width="555" height="60" backcolor="#F9F9F9" uuid="r-conf-cad"/>
				<graphicElement><pen lineWidth="0.5" lineColor="#CCCCCC"/></graphicElement>
			</rectangle>
			<textField>
				<reportElement x="10" y="90" width="370" height="13" uuid="t-al-cf"/>
				<textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Estudante: " + $F{nome_aluno}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="385" y="90" width="160" height="13" uuid="t-cd-cf"/>
				<textElement textAlignment="Right"><font fontName="DejaVu Sans" size="8"/></textElement>
				<textFieldExpression><![CDATA["Cód: " + $F{cod_aluno} + " | Mat: " + $F{cod_matricula}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="10" y="104" width="535" height="13" uuid="t-cur-cf"/>
				<textElement><font fontName="DejaVu Sans" size="8"/></textElement>
				<textFieldExpression><![CDATA["Curso: " + $F{nm_curso} + " - " + $F{nm_serie} + " | Turma: " + $F{nm_turma} + " - Ano Letivo: " + $P{ano}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="10" y="118" width="535" height="13" uuid="t-fil-cf"/>
				<textElement><font fontName="DejaVu Sans" size="8"/></textElement>
				<textFieldExpression><![CDATA["Filiação: " + $F{nm_mae} + " / " + $F{nm_pai} + "  |  Situação: " + $F{situacao_aluno}]]></textFieldExpression>
			</textField>

			<rectangle>
				<reportElement x="0" y="160" width="555" height="380" uuid="r-tabela-conf"/>
				<graphicElement><pen lineWidth="0.5" lineColor="#999999"/></graphicElement>
			</rectangle>
			<staticText>
				<reportElement x="10" y="170" width="535" height="20" forecolor="#990000" uuid="st-aviso"/>
				<textElement textAlignment="Center"><font fontName="DejaVu Sans" size="10" isBold="true"/></textElement>
				<text><![CDATA[QUADRO DE CONFERÊNCIA PRÉVIA DE NOTAS, CARGA HORÁRIA E FREQUÊNCIA]]></text>
			</staticText>

			<staticText>
				<reportElement x="20" y="210" width="515" height="120" uuid="st-inst-cf"/>
				<textElement textAlignment="Justified" lineSpacing="1_1_2"><font fontName="DejaVu Sans" size="9"/></textElement>
				<text><![CDATA[Este espelho de conferência destina-se exclusivamente à verificação interna prévia pela Secretaria Escolar antes da emissão definitiva e encadernação do Histórico Escolar oficial.

Itens a conferir:
[  ] Grafia correta do nome do aluno e dos genitores (conforme Certidão de Nascimento / RG)
[  ] Data de nascimento e naturalidade (Município / UF)
[  ] Notas / médias de todas as séries anteriores e carga horária anual cumprida
[  ] Situação de aprovação / progressão em cada ano letivo
[  ] Portarias de autorização e reconhecimento dos cursos]]></text>
			</staticText>

			<line>
				<reportElement x="50" y="440" width="200" height="1" uuid="l-conf-sec"/>
			</line>
			<staticText>
				<reportElement x="50" y="444" width="200" height="20" uuid="st-conf-sec"/>
				<textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8"/></textElement>
				<text><![CDATA[Conferido por (Secretaria Escolar)]]></text>
			</staticText>

			<line>
				<reportElement x="305" y="440" width="200" height="1" uuid="l-conf-dir"/>
			</line>
			<staticText>
				<reportElement x="305" y="444" width="200" height="20" uuid="st-conf-dir"/>
				<textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8"/></textElement>
				<text><![CDATA[Visto da Direção Escolar]]></text>
			</staticText>

			<textField>
				<reportElement x="0" y="560" width="555" height="15" forecolor="#666666" uuid="t-rodape-cf"/>
				<textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isItalic="true"/></textElement>
				<textFieldExpression><![CDATA["* Este documento NÃO substitui o Histórico Escolar oficial e não possui validade para transferência externa."]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<pageFooter>
		<band height="20">
			<textField>
				<reportElement x="0" y="5" width="300" height="12" uuid="foot-cf"/>
				<textElement><font fontName="DejaVu Sans" size="7"/></textElement>
				<textFieldExpression><![CDATA["Emitido para conferência em " + $F{data_atual}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="455" y="5" width="100" height="12" uuid="foot-pg-cf"/>
				<textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7"/></textElement>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
